{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  // Custom NixOS logo from logo.txt; $1 and $2 in the file are the two colors below
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 3,
      "left": 2,
      "right": 4
    }
  },

  // Only ANSI colors (names / numbers) so everything follows the dux terminal palette.
  // Keys are padded by hand to the same length, so every "~>" lines up.
  "display": {
    "separator": " ~>  ",
    "color": {
      "keys": "blue",
      "output": "default"
    }
  },

  "modules": [
    "title",

    "break",

    { "type": "os",       "key": " os      " },
    { "type": "kernel",   "key": " kernel  " },
    { "type": "uptime",   "key": " uptime  " },
    { "type": "packages", "key": " packages" },
    { "type": "shell",    "key": " shell   " },

    "break",

    { "type": "wm", "key": " wm      " },
    {
      "type": "display",
      "key": " display ",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },

    "break",

    {
      "type": "bios",
      "key": " bios    ",
      "format": "{version} ({release})"
    },
    { "type": "cpu", "key": " cpu     " },
    { "type": "gpu", "key": " gpu     " },
    {
      "type": "memory",
      "key": " ram     ",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": " disk    ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    }
  ]
}
