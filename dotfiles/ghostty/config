# Colors come from dux shell (generated from the wallpaper).
# The theme file appears after the first wallpaper or theme change.
theme = dankcolors

# Window
background-opacity = 0.85
window-decoration = none
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# Selection and mouse
copy-on-select = clipboard
mouse-hide-while-typing = true

# Hide the "config reloaded" / "copied" toasts
app-notifications = no-clipboard-copy,no-config-reload
