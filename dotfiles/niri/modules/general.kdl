// General
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
// Don't show the hotkey overlay on login
hotkey-overlay {
    skip-at-startup
}
// Disable pasting with middle click
clipboard {
    disable-primary
}
// Lets Noctalia focus windows from notifications
debug {
    honor-xdg-activation-with-invalid-serial
}
